# /api/ask — every variable is server-only. Copy to .env.local and fill in.
# The model is paid by Pulin; the budget thresholds below stop calls once reached.

ASK_ENABLED=true
ASK_PROVIDER=openai-compatible

# OpenAI-compatible chat completions endpoint (first target: DeepSeek V4 Flash).
ASK_MODEL_BASE_URL=
ASK_MODEL=
ASK_MODEL_API_KEY=
# USD per million tokens, from the provider's price list. No defaults.
ASK_PRICE_INPUT_USD_PER_MTOK=
ASK_PRICE_OUTPUT_USD_PER_MTOK=

# Counters. Required in production; without them outside production the counters
# live in memory (and the model is still called and billed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# HMAC salt for visitor IPs. Required in production.
ASK_IP_SALT=

ASK_DAILY_BUDGET_USD=2
ASK_MONTHLY_BUDGET_USD=20
ASK_VISITOR_DAILY_LIMIT=10
ASK_MAX_QUESTION_CHARS=100
# Must stay below the drawer's 6000 ms wait.
ASK_SERVER_DEADLINE_MS=5000
